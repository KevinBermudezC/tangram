# -----------------------------------------------------------------------------
# Tangram backend configuration.
#
# This file is the source of truth for every backend setting. Copy it to .env
# and edit. The Python code (app/core/config.py) has no hardcoded defaults;
# every value must be present here.
# -----------------------------------------------------------------------------

# --- App metadata ------------------------------------------------------------

APP_NAME=Tangram
APP_VERSION=0.1.0
ENVIRONMENT=development

# --- Filesystem-backed storage roots (auto-created on first use) -------------

DATA_DIR=data
CHROMA_PATH=data/patterns.chroma

# --- HTTP --------------------------------------------------------------------

CORS_ORIGINS=["http://localhost:3000"]

# --- LLM provider selection --------------------------------------------------
# Pick one. The chat model for the chosen provider must also be set below.

LLM_PROVIDER=ollama

# --- Ollama (local or cloud) -------------------------------------------------
#   Local:  OLLAMA_BASE_URL=http://localhost:11434  + leave OLLAMA_API_KEY empty
#   Cloud:  OLLAMA_BASE_URL=https://ollama.com      + set OLLAMA_API_KEY

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=qwen3:4b-instruct

# --- OpenAI (BYOK) -----------------------------------------------------------

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Anthropic (BYOK) --------------------------------------------------------

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# --- Embedder ----------------------------------------------------------------
# Independent of LLM_PROVIDER. Format: <provider>/<model>.

EMBEDDER=ollama/nomic-embed-text-v2-moe

# --- Operational guardrails --------------------------------------------------
# MAX_INPUT_CHARS:     hard cap on the user's `prompt` field on POST /generate.
# MAX_LLM_INPUT_CHARS: hard cap on the full composed message list (mode prompt
#                      + component summaries + retrieved patterns + findings
#                      + user prompt) sent to the LLM.
# MAX_OUTPUT_TOKENS:   hard cap on the LLM response length.

MAX_INPUT_CHARS=4000
MAX_LLM_INPUT_CHARS=64000
MAX_OUTPUT_TOKENS=2048
