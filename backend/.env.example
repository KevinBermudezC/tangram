ENVIRONMENT=development

# Filesystem storage roots (created on first run if missing)
DATA_DIR=data
CHROMA_PATH=data/patterns.chroma

CORS_ORIGINS=["http://localhost:3000"]

# LLM provider — one of: ollama | openai | anthropic
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# BYOK — leave blank if using a local provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedder used to seed and update the patterns vector store
# Format: <provider>/<model>
EMBEDDER=ollama/nomic-embed-text

# Operational guardrails (see docs/architecture/0001-guardrails-strategy.md)
MAX_INPUT_CHARS=4000
MAX_OUTPUT_TOKENS=2048
