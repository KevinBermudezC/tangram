ENVIRONMENT=development

# Filesystem storage roots (created on first run if missing)
DATA_DIR=data
CHROMA_PATH=data/patterns.chroma

CORS_ORIGINS=["http://localhost:3000"]

# LLM provider — one of: ollama | openai | anthropic
LLM_PROVIDER=ollama

# Ollama base URL.
#   Local:  http://localhost:11434
#   Cloud:  https://ollama.com    (requires OLLAMA_API_KEY)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# BYOK — leave blank if using a local provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Chat model per provider. The adapter for the active LLM_PROVIDER reads its own.
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# Embedder used to seed and update the patterns vector store
# Format: <provider>/<model>
EMBEDDER=ollama/nomic-embed-text-v2-moe

# Operational guardrails (see docs/architecture/0001-guardrails-strategy.md)
MAX_INPUT_CHARS=4000
MAX_OUTPUT_TOKENS=2048
